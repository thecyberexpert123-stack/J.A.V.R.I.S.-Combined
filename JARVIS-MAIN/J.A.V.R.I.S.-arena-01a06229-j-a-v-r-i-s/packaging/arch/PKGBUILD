# Maintainer: JARVIS owners <thecyberexpert123-stack@users.noreply.github.com>
# AUR package: builds from the GitHub v-tag (ADR-0011).
# License note: upstream LICENSE decision is pending; do not redistribute widely until set.
pkgname=jarvis-agent
pkgver=1.10.2
pkgrel=1
pkgdesc="JARVIS (Just A Rather Very Intelligent System) — verified automation agent for Linux"
arch=(any)
url="https://github.com/thecyberexpert123-stack/J.A.V.R.I.S."
license=(LicenseRef-Proprietary-Until-Owner-Decides)
depends=("python>=3.10")
source=("$pkgname-$pkgver-py3-none-any.whl::https://github.com/thecyberexpert123-stack/J.A.V.R.I.S/releases/download/v$pkgver/jarvis_agent-$pkgver-py3-none-any.whl")
sha256sums=('SKIP')  # replace with the release artifact's sha256 before publishing

package() {
    install -d "$pkgdir/usr/share/jarvis/lib" "$pkgdir/usr/bin"
    WHEEL="$(ls "$srcdir"/jarvis_agent-*.whl | head -n1)"
    unzip -q "$WHEEL" -d "$pkgdir/usr/share/jarvis/lib"
    cat > "$pkgdir/usr/bin/jarvis" <<'SH'
#!/bin/sh
exec env PYTHONPATH="/usr/share/jarvis/lib${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m jarvis "$@"
SH
    chmod 755 "$pkgdir/usr/bin/jarvis"
}
